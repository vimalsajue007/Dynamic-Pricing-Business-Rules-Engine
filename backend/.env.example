# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- MySQL ---
# NOTE: avoid a literal `%` character in the password on Windows/PowerShell setups —
# it can break some tools' config parsing. The app itself URL-encodes it safely either way.
MYSQL_USER=pricing_user
MYSQL_PASSWORD=pricing_pass
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DB=pricing_engine
MYSQL_ROOT_PASSWORD=root_pass

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=300

# --- Pricing defaults ---
DEFAULT_TAX_RATE_PERCENT=8.0
MAX_TOTAL_DISCOUNT_PERCENT=60.0
